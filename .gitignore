# Ignora tots els fitxers i carpetes solts de l'arrel excepte els 4 directoris i fitxers base del repo
/*
!/.gitattributes
!/.gitignore
!/README.md
!/calypso_2_1/
!/calypso_4_1_e/
!/calypso_6_2_b/
!/datathon-fme-2026-main/

# Entorn i credencials
.env
*.env
!.env.example
.active_model.json

# Python / eines de desenvolupament
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
.venv/
*.pkl

# Caches i logs en temps d'execucio (dins dels models conservats)
calypso_2_1/cache/
calypso_2_1/logs/
calypso_4_1_e/cache/
calypso_4_1_e/logs/
calypso_6_2_b/cache/
calypso_6_2_b/logs/
etapa_*/cache/
etapa_*/logs/
